(env
 (dev
  (flags
   (:standard -warn-error -A))))

(alias
 (name default)
 (deps
  schematic-cli.opam
  schematic-http.opam
  schematic-jsoo.opam
  schematic-sexp.opam
  schematic-sqml.opam
  schematic-c.opam
  schematic.opam
  (alias_rec schematic/default)
  (alias_rec schematic-http/default)
  (alias_rec schematic-jsoo/default)
  (alias_rec schematic-sexp/default)
  (alias_rec schematic-sqml/default)
  (alias_rec schematic-c/default)))

(rule
 (target schematic.%{version:schematic}.opam)
 (deps
  (:opam schematic.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (echo
     "url {\n  src: \"git://git@gitlab.routine.co:routine/schematic#%{version:schematic}\"\n}\n")))))

