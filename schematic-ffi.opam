# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.15.0"
synopsis: "Generate FFI types and converters based on schemas"
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["Yohaï-Eliel BERREBY <yberreby@pm.me>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/schematic"
bug-reports: "https://gitlab.routine.co/routine/schematic/-/issues"
depends: [
  "dune" {>= "2.9"}
  "bake"
  "logs"
  "ppx_hash" {= "v0.14.0"}
  "schematic" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://gitlab.routine.co/routine/schematic.git"
