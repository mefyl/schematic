(** Swift serialization interface for Schematic.

    This module defines both a schematic-based serialization format compatible
    with Swift's [JSONEncoder]/[JSONDecoder], and a generator that outputs
    matching Swift type declarations. *)

(** A parsed Swift type declaration and expression. *)
type t

(** [of_packed_schemas schemas] is the list of Swift type declarations and
    expressions found in [schemas]. *)
val of_packed_schemas : Schema.pack list -> t list

(** [pp fmt t] outputs the Swift type declarations, annotated with Swiftx
    serialization support, for [t] to [fmt].

    This only prints the type declarations in itself, not the required imports. *)
val pp : Format.formatter -> t -> unit

(** [pp_file fmt ts] outputs a full, compiling Swift file content, including
    type declarations, annotated with Swift serialization support, for [ts] to
    [fmt].

    All basic type imports are also included (e.g. [Foundation]). *)
val pp_file : Format.formatter -> t list -> unit

(** [to_json schema a] encodes [a] into JSON using [schema]. Compatibility is
    only guaranteed with JSON parsing from either:
    - [from_json schema json]
    - a Swift call to [JSONDecoder().decode()] using types generated by [pp] or
      [pp_file]. *)
val to_json : 'a Schema.t -> 'a -> Ezjsonm.value

(** [from_json schema json] decodes [json] using [schema]. Compatibility is only
    guaranteed with JSON data generated by either:
    - [to_json schema a]
    - a Swift call to [JSONEncoder().encode()] using types generated by [pp] or
      [pp_file]. *)
val from_json : 'a Schema.t -> Ezjsonm.value -> ('a, Error.decoding) Result.t

(** [to_type_name s] returns a valid Swift type name for [s]. *)
val to_type_name : string -> string
