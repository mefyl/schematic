opam-version: "2.0"
name: "schematic"
version: "0.19.0"
synopsis: "Derive schemas from Ocaml types"
description: """\
Schematic lets you derive type meta informations using a ppx_deriving
driver and provide functionalities on top of it:

* Conversion to and from JSON.
* Deduction of JSON schema specification.
* Conversion to and from js_of_ocaml FFI using schematic-jsoo.
* Deduction of typescript definitions."""
maintainer: "mefyl <mefyl@gruntech.org>"
authors: "mefyl <mefyl@gruntech.org>"
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/schematic"
bug-reports: "https://gitlab.routine.co/routine/schematic/-/issues"
depends: [
  "ocamlformat" {= "0.26.1"}
  "opam-file-format"
  "sexplib"
  "alcotest" {= "1.7.0" & with-test}
  "angstrom" {= "0.16.0"}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.15.1"}
  "base-bigarray" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.1"}
  "bigstringaf" {= "0.9.1"}
  "cmdliner" {= "1.2.0"}
  "conf-autoconf" {= "0.1"}
  "conf-which" {= "1"}
  "cppo" {= "1.6.9"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "dune" {= "3.12.1"}
  "dune-configurator" {= "3.12.1"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.9.0"}
  "hex" {= "1.5.0"}
  "jsonm" {= "1.0.2"}
  "landmarks" {= "1.4"}
  "landmarks-ppx" {= "1.4"}
  "metapp" {= "0.4.4"}
  "ocaml" {= "4.14.1"}
  "ocaml-base-compiler" {= "4.14.1"}
  "ocaml-compiler-libs" {= "v0.12.4"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocamlbuild" {= "0.14.2"}
  "ocamlfind" {= "1.9.6"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "5.2.1"}
  "ppx_here" {= "v0.15.0"}
  "ppx_yojson" {= "1.3.0" & with-test}
  "ppxlib" {= "0.31.0"}
  "ptime" {= "1.1.0"}
  "re" {= "1.11.0" & with-test}
  "result" {= "1.5"}
  "semver2" {= "1.2.0"}
  "seq" {= "base"}
  "sexplib0" {= "v0.15.1"}
  "stdcompat" {= "19"}
  "stdlib-shims" {= "0.3.0"}
  "stringext" {= "1.6.0"}
  "topkg" {= "1.0.7"}
  "uri" {= "4.4.0"}
  "uutf" {= "1.0.3"}
]
conflicts: [
  "dune" {= "3.7.0" | = "3.7.1"}
]
dev-repo: "git+https://gitlab.routine.co/routine/schematic.git"
pin-depends: [
  ["landmarks.1.4" "git+https://github.com/routineco/landmarks.git#js"]
  ["landmarks-ppx.1.4" "git+https://github.com/routineco/landmarks.git#js"]
]
