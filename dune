(dirs
 schematic
 schematic-ffi
 schematic-http
 schematic-jsoo
 schematic-sexp
 schematic-sqml
 .logistic)

(env
 (dev
  (flags
   (:standard -warn-error -A))))

(alias
 (name default)
 (deps
  schematic-cli.opam
  schematic-ffi.opam
  schematic-http.opam
  schematic-jsoo.opam
  schematic-sexp.opam
  schematic-sqml.opam
  schematic.opam
  (alias_rec schematic/default)
  (alias_rec schematic-http/default)
  (alias_rec schematic-jsoo/default)
  (alias_rec schematic-sexp/default)
  (alias_rec schematic-sqml/default)
  (alias_rec schematic-ffi/default)))

(rule
 (target dune.extdeps.inc)
 (alias extdeps)
 (deps dune-project)
 (mode (promote))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:.logistic/dune/extdeps/extdeps.exe}
    generate
    --exclude
    acid,bake))))

(include dune.extdeps.inc)
