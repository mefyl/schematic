(rule
 (deps (universe))
 (target schematic.opam.locked)
 (action
  (run %{bin:opam} lock schematic)))

(rule
 (mode
  (promote (until-clean)))
 (target schematic.opam.extdeps)
 (alias extdeps)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:awk}
    "/^build: / { exit 0 }; !/^  \"(ocaml)/ { print($0) }"
    %{dep:schematic.opam.locked}))))

(rule
 (deps (universe))
 (target schematic-jsoo.opam.locked)
 (action
  (run %{bin:opam} lock schematic-jsoo)))

(rule
 (mode
  (promote (until-clean)))
 (target schematic-jsoo.opam.extdeps)
 (alias extdeps)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:awk}
    "/^build: / { exit 0 }; !/^  \"(ocaml|schematic)/ { print($0) }"
    %{dep:schematic-jsoo.opam.locked}))))

