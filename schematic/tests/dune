(include_subdirs unqualified)

(library
 (name test_utils)
 (modules test_utils tests)
 (preprocess
  (pps
   ppx_deriving.eq
   ppx_deriving.make
   ppx_deriving.show
   ppx_deriving.ord
   ppx_here
   ppx_yojson
   schematic_ppx
   --
   --cookie
   "schematic-version=\"0.15.0\""))
 (libraries alcotest ezjsonm hlist schematic base fmt))

