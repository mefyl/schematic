#!/bin/sh +ex

staged () {
    git show ":$1"
}

VERSION=$(staged dune-project | sed -n '/version/{s/(version \(.*\))/\1/p;q}')
VERSION="V${VERSION//./_}"

check () {
    if ! staged "$1" | grep -q "$VERSION"; then
        echo "missing module $VERSION in $1" 1>&2
        exit 1
    fi
}

check "schematic/src/schematic.ml"
check "schematic/src/versions.ml"
check "schematic-jsoo/lib/src/schematic_jsoo.ml"
check "schematic-jsoo/lib/src/versions.ml"
