(rule
 ; - Build the Kotlin roundtrip test app
 ; - Unzip the built artifact
 ; - Move the binary (and its libs) in a directory accessible from the OCaml test
 (alias build-kotlin-test-app)
 (target
  (dir kotlin-app))
 (mode
  (promote (until-clean)))
 (deps
  (alias_rec generate-kotlin-test-controller)
  (source_tree kotlin))
 (action
  (progn
   (chdir
    kotlin
    (progn
     (run gradle distZip --no-daemon)))
   (chdir
    kotlin/app/build/distributions
    (progn
     (run rm --recursive --force app)
     (run unzip app.zip)))
   (run cp --recursive kotlin/app/build/distributions/app/ %{target}))))

(test
 (name kotlin_roundtrip)
 (modules kotlin_roundtrip)
 (libraries alcotest schematic test_utils)
 (deps
  (alias build-kotlin-test-app))
 (preprocess
  (pps ppx_here schematic.ppx ppx_deriving.show)))

(executable
