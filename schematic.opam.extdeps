opam-version: "2.0"
name: "schematic"
version: "0.14.2"
synopsis: "Derive schemas from Ocaml types"
description: """\
Schematic lets you derive type meta informations using a ppx_deriving
driver and provide functionalities on top of it:

* Conversion to and from JSON.
* Deduction of JSON schema specification.
* Conversion to and from js_of_ocaml FFI using schematic-jsoo.
* Deduction of typescript definitions."""
maintainer: "mefyl <mefyl@gruntech.org>"
authors: "mefyl <mefyl@gruntech.org>"
license: "GPLv3"
homepage: "https://gitlab.routine.co/routine/schematic"
bug-reports: "https://gitlab.routine.co/routine/schematic/-/issues"
depends: [
  "alcotest" {= "1.6.0" & with-test}
  "angstrom" {= "0.15.0"}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.14.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.0"}
  "bigstringaf" {= "0.9.0"}
  "cmdliner" {= "1.1.1"}
  "conf-pkg-config" {= "2"}
  "cppo" {= "1.6.9"}
  "csexp" {= "1.5.1"}
  "cstruct" {= "6.1.0"}
  "dune" {= "3.3.1"}
  "dune-configurator" {= "3.3.1"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.9.0"}
  "hex" {= "1.5.0"}
  "jsonm" {= "1.0.1"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "5.2.1"}
  "ppx_here" {= "v0.14.0"}
  "ppx_yojson" {= "1.2.0" & with-test}
  "ppxlib" {= "0.25.0"}
  "ptime" {= "1.0.0"}
  "re" {= "1.10.4" & with-test}
  "result" {= "1.5"}
  "semver2" {= "1.2.0"}
  "seq" {= "base" & with-test}
  "sexplib0" {= "v0.14.0"}
  "stdlib-shims" {= "0.3.0"}
  "stringext" {= "1.6.0"}
  "topkg" {= "1.0.5"}
  "uchar" {= "0.0.2"}
  "uri" {= "4.2.0"}
  "uutf" {= "1.0.3"}
]
