(rule
 (target entropic.%{version:entropic}.opam)
 (deps
  (:opam ../entropic.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run
     git
     log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/schematic#%H\" }"
     -n1)))))

(rule
 (target entropic-ios.opam)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{target}
   (run
    %{workspace_root}/.logistic/ci/dune/dune_sak.exe
    rewrite-ios
    --input
    %{dep:../entropic.opam}
    --cross
    entropic,schematic,schematic-cli,schematic-jsoo,schematic-sexp,acid,hlist,timmy,base,base64,csexp,ezjsonm,fmt,hlist,logs,ptime,sexplib,uri
    --cross-both
    fmt,ppx_deriving,ppx_here,semver2
    --cross-exclude
    ""))))

