(rule
 (mode
  (promote (until-clean)))
 (target schematic-sqml.opam.extdeps)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:awk}
    "/^build: / { exit 0 }; !/^  \"(acid|ocaml|schematic|sqml|timmy)/ { print($0) }"
    %{dep:schematic-sqml.opam.locked}))))

