(library
 (name c_test_types)
 (package schematic)
 (modules c_test_types)
 (preprocess
  (pps schematic_ppx ppx_deriving.eq ppx_deriving.show ppx_deriving.make))
 (libraries schematic schematic_c ptime))

(test
 (name c_gen_test)
 (package schematic)
 (modules c_gen_test)
 (preprocess
  (pps schematic_ppx ppx_deriving.eq ppx_deriving.show))
 (libraries alcotest schematic schematic_c c_test_types))

(executable
 (name c_gen_roundtrip_stubs)
 (modules c_gen_roundtrip_stubs)
 (libraries alcotest schematic schematic_c c_test_types stdio logs logs.fmt))

(rule
 (targets c_roundtrip_stubs.h c_roundtrip_stubs.c)
 (deps (universe))
 (action
  (run %{dep:c_gen_roundtrip_stubs.exe} %{targets})))

(test
 (name c_roundtrip)
 (package schematic)
 (modes exe)
 (deps c_roundtrip_stubs.o (universe))
 (foreign_stubs
  (language c)
  (names c_roundtrip_stubs)
  ; When debugging:
