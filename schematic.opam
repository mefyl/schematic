# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.19.4"
synopsis: "Derive schemas from Ocaml types"
description: """
Schematic lets you derive type meta informations using a ppx_deriving
driver and provide functionalities on top of it:

* Conversion to and from JSON.
* Deduction of JSON schema specification.
* Conversion to and from js_of_ocaml FFI using schematic-jsoo.
* Deduction of typescript definitions.
"""
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["mefyl <mefyl@gruntech.org>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/schematic"
bug-reports: "https://gitlab.routine.co/routine/schematic/-/issues"
depends: [
  "dune" {>= "3.0"}
  "logs" {>= "0.7.0"}
  "alcotest" {>= "1.1.0" & with-test}
  "base" {>= "v0.17.0"}
  "base64" {>= "3.5.0"}
  "ezjsonm" {>= "1.1.0"}
  "fmt"
  "hlist" {>= "0.2.0" & < "0.3.0"}
  "landmarks"
  "landmarks-ppx"
  "ocaml" {>= "5.2.0"}
  "ppxlib"
  "ppx_deriving"
  "ppx_here"
  "ppx_yojson" {>= "1.2.0" & with-test}
  "ptime" {>= "1.0.0"}
  "semver2" {>= "1.2.0"}
  "uri"
  "odoc" {with-doc}
]
conflicts: [
  "dune" {= "3.7.0" | = "3.7.1"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://gitlab.routine.co/routine/schematic.git"
pin-depends: [
  [ "landmarks.1.4" "git+https://github.com/routineco/landmarks.git#js" ]
  [ "landmarks-ppx.1.4" "git+https://github.com/routineco/landmarks.git#js" ]
  # Required for OCaml 5.2 until `stdcompat` releases a version 20
  [ "stdcompat.19" "git+https://github.com/thierry-martinez/stdcompat.git#d53390d788027fe0a2282c4745eb3d1626341f99" ]
]
