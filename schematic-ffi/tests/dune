(include_subdirs no)

(executable
 (name gen_roundtrip_stubs)
 (modules gen_roundtrip_stubs)
 (libraries
  alcotest
  schematic
  schematic_ffi
  ffi_test_utils
  stdio
  logs
  logs.fmt))

(executable
 (name gen_swift_schemas)
 (modules gen_swift_schemas)
 (libraries
  alcotest
  schematic
  schematic_ffi
  ffi_test_utils
  stdio
  logs
  logs.fmt))

(rule
 (targets roundtrip_stubs.h roundtrip_stubs.c)
 (action
  (run %{dep:gen_roundtrip_stubs.exe} %{targets})))

(rule
 (targets Schemas.swift)
 (action
  (run %{dep:gen_swift_schemas.exe} %{targets})))

(rule
 (targets Schemas.o)
 (action
  (run
   swiftc
   -c
   %{dep:Schemas.swift}
   -import-objc-header
   %{dep:roundtrip_stubs.h}
   -I
   %{ocaml_where})))

(test
 (name c_roundtrip)
 (package schematic-ffi)
 (modes exe)
 (deps
  (file roundtrip_stubs.h)
  (file roundtrip_stubs.h))
 (foreign_stubs
  (language c)
  (names roundtrip_stubs)
  ; When debugging, use -O0
  (flags -Wall))
 (modules c_roundtrip)
 (preprocess
  (pps schematic_ppx ppx_deriving.eq ppx_deriving.show metapp.ppx))
 (libraries
  alcotest
  schematic_ffi
  ffi_test_utils
  ptime
  logs
  logs.fmt
  ppxlib
  ppxlib.ast
  metapp))
