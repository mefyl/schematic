(include_subdirs no)

(rule
 (alias generate-kotlin-test-controller)
 (target GeneratedTestController.kt)
 (mode
  (promote (until-clean)))
 (action
  (progn
   (with-stdout-to
    "%{target}"
    ; Because Dune neither supports [(rule (target some/nested/file))] nor [(copy_files)] in a nested directory, we have to put the [dune] file here to copy the generated Kotlin file here...
    (run "%{dep:../../../../../../../kotlin_test_controller_generator.exe}"))
   (run ktfmt %{target}))))
