(** A parsed Kotlin type declaration and expression. *)
type t

(** [of_packed_schemas schemas] is the list of Kotlin type declarations and
    expressions found in [schemas]. *)
val of_packed_schemas : Schema.pack list -> t list

(** [pp fmt t] outputs the Kotlin type declarations, annotated with Kotlinx
    serialization support, for [t] to [fmt].

    This only prints the type declarations in itself, not the required imports.
*)
val pp : Format.formatter -> t -> unit

(** [pp_file ?package fmt ts] outputs a full, compiling Kotlin file content,
    including type declarations, annotated with Kotlinx serialization support,
    for [ts] to [fmt].

    All basic type imports are also included (e.g. [LocalDate]).

    If [package] is provided, the file content includes a [package] statement.
*)
val pp_file : ?package:string -> Format.formatter -> t list -> unit

(** The Kotlin JSON {!Coding.coding} tag *)
type _ Coding.coding += Coding : Ezjsonm.value Coding.coding

(** [to_json schema a] encodes [a] into JSON using [schema]. Compatibility is
    only guaranteed with JSON parsing from either:
    - [from_json schema json]
    - a Kotlin call to [Json.decodeFromString()] using types generated by [pp]
      or [pp_file]. *)
val to_json : 'a Schema.t -> 'a -> Ezjsonm.value

(** [from_json schema json] decodes [json] using [schema]. Compatibility is only
    guaranteed with JSON data generated by either:
    - [to_json schema a]
    - a Kotlin call to [Json.encodeToString()] using types generated by [pp] or
      [pp_file]. *)
val from_json : 'a Schema.t -> Ezjsonm.value -> ('a, Error.decoding) Result.t

(** [to_type_name s] returns a valid Kotlin type name for [s]. *)
val to_type_name : string -> string
