opam-version: "2.0"
version: "0.17.3"
synopsis: "HTTP client with schematic encoding"
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["mefyl <mefyl@gruntech.org>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/schematic"
bug-reports: "https://gitlab.routine.co/routine/schematic/-/issues"
depends: [
  "dune" {>= "2.9"}
  "cohttp-lwt" {>= "5.0.0" & < "5.1.0"}
  "lwt" {>= "5.6.0"}
  "schematic" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://gitlab.routine.co/routine/schematic.git"
