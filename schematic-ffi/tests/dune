(include_subdirs no)

(rule
 (targets CSchemas.h CSchemas.c)
 (action
  (run %{dep:c/gen_c_rt_stubs.exe} %{targets})))

(rule
 (targets Schemas.o CSchemas.o)
 (deps
  (file swift/Schemas/Schemas.o)
  (file swift/Schemas/CSchemas.o))
 (action
  (progn
   (run cp %{deps} .))))

(rule
 (targets
  libswiftCore.a
  libswiftDispatch.a
  libFoundation.a
  libdispatch.a
  libBlocksRuntime.a
  libCoreFoundation.a
  libicui18nswift.a
  libicuucswift.a
  libswiftGlibc.a
  libDispatchStubs.a
  libicudataswift.a
  libswiftSwiftOnoneSupport.a
  libswift_StringProcessing.a)
 (action
  (progn
   ; XXX: hardcoded path
   (system "cp /usr/lib/swift/lib/swift_static/linux/*.a ."))))

; Simpler to use (extra_objects ...), but only available in dune 3.5+

(rule
 (target libroundtrip.a)
 (action
  (run ar rc %{target} %{dep:Schemas.o} %{dep:CSchemas.o})))

