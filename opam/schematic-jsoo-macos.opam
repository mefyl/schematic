opam-version: "2.0"
version: "0.21.1"
synopsis: "Derive js_of_ocaml types and values from Ocaml types"
description: """
Deduce js_of_ocaml FFI types
 and conversion functions from schematic type metadata."""
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["mefyl <mefyl@gruntech.org>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/schematic"
bug-reports: "https://gitlab.routine.co/routine/schematic/-/issues"
depends: [
  "dune" {>= "3.20"}
  "base-macos"
  "ezjsonm-macos"
  "fmt"
  "fmt-macos"
  "js_of_ocaml" {>= "4.0.0" & < "7.0.0"}
  "js_of_ocaml-ppx" {>= "4.0.0" & < "7.0.0"}
  "ppx_here"
  "ppx_here-macos"
  "ptime-macos"
  "schematic-macos" {= version}
  "uri-macos"
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-x" "macos" "-p" "schematic-jsoo" "-j" jobs "@install"]
]
dev-repo: "git+https://gitlab.routine.co/routine/schematic.git"
x-maintenance-intent: ["(latest)"]
