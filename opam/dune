(rule
 (target entropic.%{version:entropic}.opam)
 (deps
  (:opam ../entropic.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run git log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/entropic#%H\" }"
     -n1)))))

