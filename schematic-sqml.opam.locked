opam-version: "2.0"
name: "schematic-sqml"
version: "0.12.0"
synopsis: "Derive SQML bindings from Ocaml types"
description: "Deduce SQML bindings from schematic type metadata."
maintainer: "mefyl <mefyl@gruntech.org>"
authors: "mefyl <mefyl@gruntech.org>"
license: "GPLv3"
homepage: "https://gitlab.routine.co/routine/schematic"
bug-reports: "https://gitlab.routine.co/routine/schematic/-/issues"
depends: [
  "acid" {= "0.6.8"}
  "alcotest" {= "1.5.0" & with-test}
  "angstrom" {= "0.15.0"}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.14.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.0"}
  "bigarray-compat" {= "1.1.0"}
  "bigstringaf" {= "0.8.0"}
  "biniou" {= "1.2.1"}
  "cmdliner" {= "1.1.0"}
  "conf-pkg-config" {= "2"}
  "cppo" {= "1.6.8"}
  "csexp" {= "1.5.1"}
  "cstruct" {= "6.0.1"}
  "dune" {= "3.0.3"}
  "dune-configurator" {= "3.0.3"}
  "easy-format" {= "1.3.2"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.9.0"}
  "hex" {= "1.4.0"}
  "js_of_ocaml" {= "4.0.0"}
  "js_of_ocaml-compiler" {= "4.0.0"}
  "js_of_ocaml-ppx" {= "4.0.0"}
  "jsonm" {= "1.0.1"}
  "logs" {= "0.7.0"}
  "lwt" {= "5.5.0"}
  "lwt_ppx" {= "2.0.3"}
  "menhir" {= "20220210"}
  "menhirLib" {= "20220210"}
  "menhirSdk" {= "20220210"}
  "mmap" {= "1.2.0"}
  "ocaml" {= "4.12.0"}
  "ocaml-base-compiler" {= "4.12.0"}
  "ocaml-compiler-libs" {= "v0.12.4"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocamlbuild" {= "0.14.1"}
  "ocamlfind" {= "1.9.3"}
  "ocplib-endian" {= "1.2"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "5.2.1"}
  "ppx_here" {= "v0.14.0"}
  "ppx_yojson" {= "1.2.0"}
  "ppxlib" {= "0.25.0"}
  "ptime" {= "1.0.0"}
  "re" {= "1.10.3" & with-test}
  "result" {= "1.5"}
  "schematic" {= "0.12.0"}
  "schematic-jsoo" {= "0.12.0"}
  "semver2" {= "1.2.0"}
  "seq" {= "base"}
  "sexplib0" {= "v0.14.0"}
  "sqml" {= "0.4.4"}
  "stdlib-shims" {= "0.3.0"}
  "stringext" {= "1.6.0"}
  "timmy" {= "0.11.13"}
  "topkg" {= "1.0.5"}
  "uchar" {= "0.0.2"}
  "uri" {= "4.2.0"}
  "uutf" {= "1.0.3"}
  "yojson" {= "1.7.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://gitlab.routine.co/routine/schematic.git"
pin-depends: [
  [
    "schematic.0.12.0"
    "git+ssh://git@gitlab.routine.co/routine/schematic#master"
  ]
  [
    "schematic-jsoo.0.12.0"
    "git+ssh://git@gitlab.routine.co/routine/schematic#master"
  ]
]
url {
  src: "git+file:///home/mefyl/dev/routine/schematic#master"
}