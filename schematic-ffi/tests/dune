(include_subdirs no)

(executable
 (name gen_c_rt_stubs)
 (modules gen_c_rt_stubs)
 (libraries
  alcotest
  schematic
  schematic_ffi
  ffi_test_utils
  stdio
  logs
  logs.fmt))

(executable
 (name gen_swift_rt_stubs)
 (modules gen_swift_rt_stubs)
 (libraries
  alcotest
  schematic
  schematic_ffi
  ffi_test_utils
  stdio
  logs
  logs.fmt))

(rule
 (targets c_rt_stubs.h c_rt_stubs.c)
 (action
  (run %{dep:gen_c_rt_stubs.exe} %{targets})))

(rule
 (targets Swift_rt_stubs.swift)
 (action
  (run %{dep:gen_swift_rt_stubs.exe} %{targets})))

(rule
 (targets Swift_rt_stubs.o)
 (action
  (run
   swiftc
   -c
   %{dep:Swift_rt_stubs.swift}
   -import-objc-header
   %{dep:c_rt_stubs.h}
   -I
   %{ocaml_where})))

(test
 (name c_roundtrip)
 (package schematic-ffi)
 (modes exe)
 (deps
  (file c_rt_stubs.h)
  (file c_rt_stubs.h)
  (file Swift_rt_stubs.swift)
  (file Swift_rt_stubs.o))
 (foreign_stubs
  (language c)
  (names c_rt_stubs)
  ; When debugging, use -O0
  (flags -Wall))
 (modules c_roundtrip)
 (preprocess
  (pps schematic_ppx ppx_deriving.eq ppx_deriving.show metapp.ppx))
 (libraries
  alcotest
  schematic_ffi
  ffi_test_utils
  ptime
  logs
  logs.fmt
  ppxlib
  ppxlib.ast
  metapp))
