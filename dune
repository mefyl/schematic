(dirs
 entropic
 schematic
 schematic-http
 schematic-jsoo
 schematic-sexp
 .logistic
 opam)

(env
 (dev
  (flags
   (:standard -warn-error -A -warn-error +partial-match)))
 (release
  (flags
   (:standard -warn-error +A))))

(alias
 (name default)
 (deps
  entropic.opam
  schematic-cli.opam
  schematic-http.opam
  schematic-jsoo.opam
  schematic-sexp.opam
  schematic.opam
  (alias_rec entropic/default)
  (alias_rec schematic/default)
  (alias_rec schematic-http/default)
  (alias_rec schematic-jsoo/default)
  (alias_rec schematic-sexp/default)))

(rule
 (target dune.inc)
 (alias extdeps)
 (deps dune-project)
 (mode (promote))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:.logistic/dune/extdeps/extdeps.exe}
    generate
    --name
    schematic
    --cross-both
    bake,fmt,landmarks-ppx,ppx_deriving,ppx_hash,ppx_here,semver2
    --cross
    base,base64,cohttp-lwt,csexp,ezjsonm,fmt,hlist,logs,lwt,ptime,sexplib,uri
    --local
    acid,acid-lwt,bake,hlist,metaversion,timmy,timmy-lwt))))

(include dune.inc)
