(rule
 (targets Schemas.o CSchemas.o)
 (deps
  Sources/CSchemas/CSchemas.c
  Sources/CSchemas/include/CSchemas.h
  Sources/Schemas/Schemas.swift
  (source_tree .))
 (enabled_if %{bin-available:swift})
 (action
  (progn
   (run ln -sfn %{ocaml_where}/caml Sources/CSchemas/include/caml)
   ; --static-swift-stdlib would have been great, if it actually worked.
   ; (system "swift build --static-swift-stdlib"))
   ;
   ; Fun fact: on Swift version 5.7.1-dev (LLVM 7e31b78ab3255fa, Swift 1e80674d67f5505),
   ; array conversions SIGSEGV on getAssociatedTypeWitnessSlow , but only in DEBUG mode.
   (run swift build -c release)
   (run cp .build/release/CSchemas.build/CSchemas.c.o CSchemas.o)
   (run cp .build/release/Schemas.build/Schemas.swift.o Schemas.o))))
